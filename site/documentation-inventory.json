  "sourceSurfaces": {
    "cli": {
      "source": {
        "path": "src/LithoSharp.Tool/Cli.cs",
        "sha256": "d7aeff27b35300438d509ddd070c628c2b145300c7d27a0e851f81719393dd89"
      },
      "usage": [
        "capabilities [-f json] (tool, core, contract and capability report; never evaluates a project)",
        "cache <info|clean> -o directory [--cache-dir directory] (explicit per-output cache usage or reclamation)",
        "markdown-compat <markdown-file> [--advisory on|off] [--format text|json] [--project snapshot.json] (explicit Markdown compatibility check; same analysis as document inspection)",
        "new <docs|blog|empty|mdx> [name] [-o directory]",
        "snapshot <source> <destination> <version>",
        "extract-translations <source>",
        "restore-mdx <worker-directory> [--allow-scripts]",
        "migrate-docusaurus <source> (read-only JSON report; never executes config) (exit 0 done, 1 failure, 3 unconvertible)",
        "migrate testing --dry-run --source file.cs --reference baseline.dll [--source file.cs] [--reference baseline.dll] [--format json] (metadata-only JSON report; no edits or user project execution)",
        "migrate docusaurus <source> [--output directory] [--expected-routes file] [--base-url url] [--default-locale locale] [--source-version version] [--source-base-path path] [--compare-normalized-pages] (exit 0 done, 1 failure, 3 unconvertible)",
        "build [project] [-o directory] [--clean] [-c configuration]",
        "serve [project] [-o directory] [--port number] [--host address] [--format text|json] [--control-stdin] [-c configuration]",
        "check [project] [--format text|json|sarif] [-c configuration] (regenerates into temporary output)",
        "check-output -o directory --base-url url [--format text|json|sarif] [--baseline file --require-publication-compatibility --site-id id] [--allow-removals file] [--exclude-output path] (reads existing output; no generation or cache writes)",
        "check-output -o directory --base-url url --site-id id --initialize-baseline file (explicit create-only baseline initialization after verified publication)",
        "okf <inspect|validate|export> --input bundle-directory [--format text|json|sarif] [--as-of offset-datetime] [--strict-lint] [--base-url url] [--max-files count] [--max-discovery-entries count] [--max-file-bytes bytes] [--max-bundle-bytes bytes] [--output new-export-directory] (standalone bundle read; no project or computation execution)",
        "proofread <markdown-file> --python executable --yomiyasu lint-script [--profile id] [--protect identifier] [--format text|json] [--preview segment:start:length --replacement text] (explicit optional Yomiyasu execution; diagnostics and edit previews only)",
        "preview-csharp-rename --source caller.cs --reference metadata.dll --type metadata-type --member member --new-name identifier [--define symbol] [--format json] (explicit Roslyn caller preview; no project evaluation, generated-source edits or file writes)",
        "clean [project] [-o directory] [-c configuration]",
        "inspect [project] [--format text|json] [-c configuration]",
        "preflight --mode static --input file.md [--input file.mdx] [--format text|json|sarif] [--worker-directory directory]",
        "preflight project.csproj --mode trusted [--input file.md] [--format text|json|sarif] [--configuration configuration]"
      ],
      "guides": {
        "en": "docs/cli.md",
        "ja": "docs/cli.ja.md"
      }
    },
