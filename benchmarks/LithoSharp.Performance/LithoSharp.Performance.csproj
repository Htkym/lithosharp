<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LithoSharp.Performance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LithoSharp\LithoSharp.csproj" />
    <Compile Include="../../eng/performance/BenchmarkIdentity.cs" Link="BenchmarkIdentity.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableTypedDocsBenchmark)' == 'true'">
    <DefineConstants>$(DefineConstants);TYPED_DOCS_BENCHMARK</DefineConstants>
  </PropertyGroup>

</Project>
