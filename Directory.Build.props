<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <SyntamarkComponentVersion>1.0.0</SyntamarkComponentVersion>
    <SyntamarkSourceVersion Condition="'$(SyntamarkSourceVersion)' == ''">$(SyntamarkComponentVersion)</SyntamarkSourceVersion>
    <RepositoryUrl>https://github.com/Htkym/lithosharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Htkym/lithosharp</PackageProjectUrl>
  </PropertyGroup>
</Project>
