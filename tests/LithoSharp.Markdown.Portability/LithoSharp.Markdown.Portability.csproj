<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LithoSharp/LithoSharp.csproj" />
    <ProjectReference Include="../LithoSharp.Markdown.PortableHost/LithoSharp.Markdown.PortableHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/LithoSharp.Generators/LithoSharp.Generators.csproj" ReferenceOutputAssembly="false" />
    <None Include="../LithoSharp.Tests/Fixtures/MarkdigBaseline/body-basics.md"
          Link="Fixtures/body-basics.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep the runtime reference explicit; copy the actual portable target output. -->
  <Target Name="CopyPortableMarkdownComponent" BeforeTargets="CopyFilesToOutputDirectory">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../LithoSharp.Markdown.PortableHost/LithoSharp.Markdown.PortableHost.csproj"
             Targets="Build" Properties="TargetFramework=netstandard2.0"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_PortableMarkdownAssembly" />
    </MSBuild>
    <Error Condition="'@(_PortableMarkdownAssembly)' == ''" Text="Portable Markdown target output was not produced." />
    <Copy SourceFiles="@(_PortableMarkdownAssembly)" DestinationFiles="$(TargetDir)Portable/Syntamark.dll" />
  </Target>
  <Target Name="CopyPreparedMarkdownHostContract" BeforeTargets="CopyFilesToOutputDirectory">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../../src/LithoSharp.Generators/LithoSharp.Generators.csproj"
             Targets="Build" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_PreparedMarkdownHostAssembly" />
    </MSBuild>
    <Error Condition="'@(_PreparedMarkdownHostAssembly)' == ''" Text="Prepared Markdown host contract output was not produced." />
    <Copy SourceFiles="@(_PreparedMarkdownHostAssembly)" DestinationFolder="$(TargetDir)Host/" />
  </Target>
</Project>
