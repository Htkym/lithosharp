<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../LithoSharp.Tests/Fixtures/StaticApiArgumentEvaluationCases.cs"
          Link="Fixtures/StaticApiArgumentEvaluationCases.cs" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="TUnit" Version="1.72.16" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <Using Include="TUnit.Core" />
  </ItemGroup>
  <!-- No ProjectReference to the analyzer or Core: tests load the actual packed analyzer,
       while Core is supplied only as a metadata reference, never a CLR runtime assembly. -->
</Project>
