<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Syntamark" Version="[$(SyntamarkArtifactVersion)]" />
    <!-- Reflection loads the actual Generator assembly; its Roslyn references are available here. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.14.0]" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CheckArtifactVersion" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SyntamarkArtifactVersion)' == ''"
           Text="Select the immutable runtime artifact version for this canary." />
  </Target>
</Project>
