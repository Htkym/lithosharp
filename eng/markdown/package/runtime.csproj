<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LithoSharp.Markdown</AssemblyName>
    <PackageId>LithoSharp.Markdown</PackageId>
    <Version>__VERSION__</Version>
    <Authors>Htkym</Authors>
    <Description>Parse-only Markdown facts and original UTF-16 source positions.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Htkym/lithosharp</RepositoryUrl>
    <RepositoryCommit>__COMMIT__</RepositoryCommit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
    <None Include="LICENSE;README.md" Pack="true" PackagePath="/" />
    <None Include="licenses/*" Pack="true" PackagePath="licenses/" />
    <None Include="markdown/manifest.json" Pack="true" PackagePath="markdown/" />
  </ItemGroup>
</Project>
