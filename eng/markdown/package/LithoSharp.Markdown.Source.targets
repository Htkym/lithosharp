<Project>
  <PropertyGroup>
    <LithoSharpMarkdownSourcePackageVersion>__VERSION__</LithoSharpMarkdownSourcePackageVersion>
    <LithoSharpMarkdownSourceParserVersion>__PARSER_VERSION__</LithoSharpMarkdownSourceParserVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LithoSharpMarkdownIncludeSource)' == 'true'">
    <DefineConstants>$(DefineConstants);LITHOSHARP_MARKDOWN_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LithoSharpMarkdownIncludeSource)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../src/Portable/**/*.cs"
             Link="LithoSharpMarkdown/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="CheckLithoSharpMarkdownSourceArtifact" BeforeTargets="CoreCompile"
          Condition="'$(LithoSharpMarkdownIncludeSource)' == 'true'">
    <Error Condition="'$(LithoSharpMarkdownSourceVersion)' != '$(LithoSharpMarkdownSourcePackageVersion)'"
           Text="Selected Markdown source version differs from the restored immutable artifact." />
    <Error Condition="'$(LithoSharpMarkdownExpectedParserVersion)' != '' and '$(LithoSharpMarkdownExpectedParserVersion)' != '$(LithoSharpMarkdownSourceParserVersion)'"
           Text="Selected Markdown parser stamp differs from the expected pair manifest." />
  </Target>
</Project>
