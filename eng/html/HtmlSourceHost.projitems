<Project>
  <!-- Internal LithoSharp-owned HTML source; no Core runtime, site policy or search dependency. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../src/LithoSharp/HtmlParsing/*.cs"
             Exclude="$(MSBuildThisFileDirectory)../../src/LithoSharp/HtmlParsing/HtmlFacts*.cs;$(MSBuildThisFileDirectory)../../src/LithoSharp/HtmlParsing/HtmlRawAttributeFacts.cs;$(MSBuildThisFileDirectory)../../src/LithoSharp/HtmlParsing/HtmlSourceMap.cs"
             Link="HtmlParsing/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)IsExternalInit.cs" Link="HtmlParsing/IsExternalInit.cs" />
    <None Include="$(MSBuildThisFileDirectory)../../licenses/WHATWG.HTML.LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
  </ItemGroup>
</Project>
