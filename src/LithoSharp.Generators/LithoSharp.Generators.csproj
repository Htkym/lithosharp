<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LithoSharp.Generators</PackageId>
    <Version>1.1.0</Version>
    <Authors>Htkym</Authors>
    <Description>Static content binders, schemas, and typed references for LithoSharp.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/StaticManifestFingerprint.cs" Link="Shared/StaticManifestFingerprint.cs" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
    <Compile Include="..\..\eng\markdown\MarkdownYamlIdentity.cs" Link="Hosting\MarkdownYamlIdentity.cs" />
    <Compile Include="..\LithoSharp\Routing\SiteRoute.cs" Link="Shared\SiteRoute.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive\LithoSharp.Generators.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="$(TargetDir)$(TargetName).xml" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="$([MSBuild]::EnsureTrailingSlash(`$(NuGetPackageRoot)`))yamldotnet\18.1.0\lib\netstandard2.0\YamlDotNet.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" Condition="Exists('$([MSBuild]::EnsureTrailingSlash(`$(NuGetPackageRoot)`))yamldotnet\18.1.0\lib\netstandard2.0\YamlDotNet.dll')" />
  </ItemGroup>
  <ItemGroup><None Include="../LithoSharp/icon.png" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup>
    <None Include="../../licenses/YamlDotNet.LICENSE.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <!-- The component pair selects the exact default source version in Directory.Build.props. -->
  <PropertyGroup Condition="'$(SyntamarkSourceVersion)' != ''">
    <SyntamarkIncludeSource>true</SyntamarkIncludeSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(SyntamarkSourceVersion)' != ''">
    <PackageReference Include="Syntamark.Source" Version="[$(SyntamarkSourceVersion)]"
                      PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>
  <Target Name="CheckMarkdownSourceSelection" BeforeTargets="CollectPackageReferences;PrepareForBuild">
    <Error Condition="'$(SyntamarkSourceVersion)' != '$(SyntamarkComponentVersion)'"
           Text="Markdown source hosts must use the same immutable component pair as the runtime consumers." />
    <Error Condition="'$(SyntamarkSourceVersion)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SyntamarkSourceVersion)', '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$'))"
           Text="Markdown source version must be one fixed full version, without wildcard or range syntax." />
    <Error Condition="'$(SyntamarkIncludeSource)' == 'true' and '$(SyntamarkSourceVersion)' == ''"
           Text="Select an immutable SyntamarkSourceVersion before enabling Markdown source." />
  </Target>
</Project>
