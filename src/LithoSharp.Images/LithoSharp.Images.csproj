<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LithoSharp.Images</PackageId>
    <Version>0.3.0</Version>
    <Authors>Htkym</Authors>
    <Description>Declared, cached responsive image transforms for LithoSharp.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Htkym/lithosharp</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../LithoSharp/LithoSharp.csproj" /></ItemGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
  <ItemGroup><None Include="../LithoSharp/icon.png" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
