<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LithoSharp.Mdx</PackageId>
    <Version>1.1.0</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <Authors>Htkym</Authors>
    <Description>Opt-in official MDX and React static rendering for LithoSharp.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    <PackageValidationBaselineVersion Condition="$([System.String]::Copy('$(PackageVersion)').StartsWith('2.'))">1.1.0</PackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/WatchLifecycleSidecar.cs" Link="WatchLifecycleSidecar.cs" />
    <EmbeddedResource Include="Browser/*" />
    <ProjectReference Include="../LithoSharp/LithoSharp.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Remove="worker/node_modules/**/*;worker/.cache/**/*" />
    <None Update="worker/**/*" Pack="true" PackagePath="contentFiles/any/any/%(Identity)" PackageCopyToOutput="true" CopyToOutputDirectory="PreserveNewest" />
    <None Update="worker/tests/**/*" Pack="false" CopyToOutputDirectory="Never" />
    <None Update="worker/.gitignore" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup><None Include="../LithoSharp/icon.png" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
