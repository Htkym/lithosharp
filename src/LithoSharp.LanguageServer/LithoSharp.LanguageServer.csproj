<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <Version>1.1.0</Version>
    <Product>LithoSharp Language Server</Product>
    <Description>Unsaved-buffer Markdown/MDX inspection over LSP stdio. Bundled with the VS Code extension; no separate NuGet publication is required.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LithoSharp\LithoSharp.csproj" />
    <ProjectReference Include="..\LithoSharp.Mdx\LithoSharp.Mdx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="licenses/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
</Project>
