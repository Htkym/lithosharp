<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>LithoSharp</PackageId>
    <Version>0.3.0</Version>
    <Authors>Htkym</Authors>
    <Product>LithoSharp</Product>
    <Description>A type-safe static site and documentation generator for .NET. Build with C#, typed Markdown collections, dependency-aware incremental generation, and safe output publication. Add the optional MDX package for React components, versioned documentation, and selective hydration.</Description>
    <PackageTags>static-site-generator;ssg;markdown;mdx;react;docs;documentation;blog;incremental;html;rss;sitemap</PackageTags>
    <PackageProjectUrl>https://github.com/Htkym/lithosharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Htkym/lithosharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>0.3.0 adds typed content, routes, source generation, incremental builds, CLI/templates, testing APIs, and opt-in MDX/React documentation. Review the 0.2.0 migration guide and known limitations before upgrading: https://github.com/Htkym/lithosharp/blob/main/docs/migration-0.3.md</PackageReleaseNotes>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <EnablePackageValidation Condition="'$(GITHUB_ACTIONS)' == 'true'">true</EnablePackageValidation>
    <ApiCompatValidateAssemblies>true</ApiCompatValidateAssemblies>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.3" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
