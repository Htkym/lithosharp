<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>LithoSharp</PackageId>
    <Version>0.2.0</Version>
    <Authors>Htkym</Authors>
    <Product>LithoSharp</Product>
    <Description>A small, batteries-included static site generator for .NET. Give it Markdown and site settings, and it renders a Docusaurus-inspired documentation site by default. Select the built-in Blog template for listings, archives, tags, client-side search, RSS, and a sitemap. Site-specific behavior is injected through SiteCustomization.</Description>
    <PackageTags>static-site-generator;ssg;markdown;docs;documentation;blog;changelog;html;rss;sitemap;seo;opengraph</PackageTags>
    <PackageProjectUrl>https://github.com/Htkym/lithosharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Htkym/lithosharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Adds the default Docs template, an explicit Blog template, extensible template APIs, hierarchical navigation, and separate Docs and Blog samples.</PackageReleaseNotes>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <EnablePackageValidation Condition="'$(GITHUB_ACTIONS)' == 'true'">true</EnablePackageValidation>
    <ApiCompatValidateAssemblies>true</ApiCompatValidateAssemblies>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
