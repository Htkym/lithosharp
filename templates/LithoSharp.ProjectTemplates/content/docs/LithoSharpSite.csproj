<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LithoSharpVersion Condition="'$(LithoSharpVersion)' == ''">3.0.0</LithoSharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LithoSharp" Version="$(LithoSharpVersion)" />
    <PackageReference Include="LithoSharp.Generators" Version="$(LithoSharpVersion)" PrivateAssets="all" />
    <PackageReference Include="LithoSharp.Analyzers" Version="$(LithoSharpVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="content/**/*">
      <LithoSharpCollection>docs</LithoSharpCollection>
      <LithoSharpId>$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LithoSharpId>
      <LithoSharpRoute>$([System.String]::Copy('guide/%(RecursiveDir)%(Filename)/').Replace('\', '/'))</LithoSharpRoute>
    </AdditionalFiles>
  </ItemGroup>
</Project>
